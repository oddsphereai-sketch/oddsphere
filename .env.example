# ─────────────────────────────────────────────────────────────
# Oddsphere Lab — Environment variables template
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and NEVER committed.
# ─────────────────────────────────────────────────────────────

# Supabase — project URL + keys
# Find URL + anon key in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Service-role key — server-only, bypasses RLS
# Find in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Provider switches — all false during mock-first build,
# flip individually at Phase 7 (trial verification)
USE_REAL_STATS=false
USE_REAL_BETTING=false
USE_REAL_WEATHER=false
USE_REAL_PARK_FACTORS=false

# External API keys — empty during build, filled at trial verification
BALLDONTLIE_API_KEY=
SHARPAPI_KEY=
PLAYBOOK_API_KEY=
OPENWEATHER_API_KEY=

# Scores model abstraction — per-sport routing.
# At launch ALL sports use ManualScoresModelSource (Daniel uploads via /admin/scores-model).
# Flip to true per sport when its AutoScoresModelSource lands (Phase 10+).
# NCAAF auto-model deadline: August 2026.  NCAAB: November 2026.
USE_AUTO_SCORES_MODEL_MLB=false
USE_AUTO_SCORES_MODEL_NBA=false
USE_AUTO_SCORES_MODEL_NFL=false
USE_AUTO_SCORES_MODEL_NHL=false
USE_AUTO_SCORES_MODEL_UCL=false
USE_AUTO_SCORES_MODEL_NCAAF=false
USE_AUTO_SCORES_MODEL_NCAAB=false

# Cron authentication — generate locally with: openssl rand -hex 32
CRON_SECRET=your_random_hex_string_here

# Admin authentication (V1 — email allowlist + shared token).
# Phase 8 replaces with Whop session-based admin role checks.
# ADMIN_TOKEN: generate locally with: openssl rand -hex 32
ADMIN_TOKEN=your_random_hex_string_here
# Comma-separated emails — only these can hit /api/admin/*
ADMIN_EMAIL_ALLOWLIST=eltorocreate@gmail.com

# ─────────────────────────────────────────────────────────────
# AI Auditor — safe defaults for cost preview / shadow planning
# ─────────────────────────────────────────────────────────────
# Cost preview is the only enabled posture by default. It builds compact
# audit payloads, hashes them, estimates tokens/cost, and makes ZERO
# OpenAI calls. Keep these defaults until replay/shadow runs are explicitly
# approved.
AI_AUDITOR_ENABLED=false
AI_AUDITOR_SHADOW_MODE=false
AI_AUDITOR_GUARDED_LIVE_QC=false
AI_AUDITOR_COST_PREVIEW_ONLY=true
AI_AUDITOR_APPLY_FIXES=false
AI_AUDITOR_APPLY_SAFE_COPY_FIXES=false
AI_AUDITOR_APPLY_GUARDED_DOWNGRADES=false
AI_AUDITOR_ALLOW_UPGRADES=false
AI_AUDITOR_ALLOW_PICK_FLIPS=false
AI_AUDITOR_ALLOW_PROBABILITY_CHANGES=false
AI_AUDITOR_PAID_REPLAY_ENABLED=false
AI_AUDITOR_PAID_REPLAY_HARD_CAP_USD=5
AI_MARKET_ANALYST_CURRENT_ENABLED=false
AI_MARKET_ANALYST_CURRENT_HARD_CAP_USD=5
AI_DAILY_EDGE_INTELLIGENCE_ENABLED=false
AI_DAILY_EDGE_INTELLIGENCE_HARD_CAP_USD=5
AI_DAILY_EDGE_SHADOW_ENABLED=false
AI_DAILY_EDGE_SHADOW_HARD_CAP_USD=1
AI_DAILY_EDGE_SHADOW_MAX_CALLS_PER_RUN=8
AI_AUDITOR_MONTHLY_SOFT_CAP_USD=150
AI_AUDITOR_MONTHLY_PROTECT_CAP_USD=200
AI_AUDITOR_MONTHLY_HARD_CAP_USD=250
AI_AUDITOR_SKIP_UNCHANGED_PAYLOADS=true
AI_AUDITOR_ONE_CALL_PER_GAME_CARD=true
AI_AUDITOR_DISABLE_GPT55_LIVE=true
AI_AUDITOR_ESCALATION_ENABLED=true
AI_AUDITOR_ESCALATE_BEST_ANGLE=true
AI_AUDITOR_ESCALATE_LEAN=true
AI_AUDITOR_ESCALATE_MARKET_CONFLICT=true
AI_AUDITOR_ESCALATE_LOCK_PUBLIC_PLAYS=true
AI_AUDITOR_ESCALATE_NANO_WARN_BLOCK=true
AI_AUDITOR_MAX_MINI_ESCALATION_RATE=0.15
AI_AUDITOR_COST_PREVIEW_REFRESHES=8
AI_AUDITOR_COST_PREVIEW_ACTIVE_SPORTS=mlb,wnba,soccer
# Live hourly shadow estimates use STANDARD API pricing, not Batch pricing.
# Batch pricing may be configured separately later for offline historical replay.
AI_AUDITOR_PRICING_MODE=standard
AI_AUDITOR_NANO_MODEL=gpt-5.4-nano
AI_AUDITOR_MINI_MODEL=gpt-5.4-mini
AI_AUDITOR_NANO_INPUT_USD_PER_M=0.20
AI_AUDITOR_NANO_OUTPUT_USD_PER_M=1.25
AI_AUDITOR_MINI_INPUT_USD_PER_M=0.75
AI_AUDITOR_MINI_OUTPUT_USD_PER_M=4.50
AI_AUDITOR_CONSERVATIVE_PRICE_MULTIPLIER=2
AI_AUDITOR_ESTIMATE_CHARS_PER_TOKEN=4
AI_AUDITOR_INPUT_TOKEN_SAFETY_MULTIPLIER=1.15
AI_AUDITOR_ESTIMATED_OUTPUT_TOKENS_PER_GAME_CARD=700
AI_AUDITOR_ESTIMATED_MINI_OUTPUT_TOKENS=450

# Daily Edge copy-only renderer rollout — defaults OFF.
# These flags only allow deterministic renderer copy from
# lib/services/dailyEdge/memberFacingCopyRenderer.ts. Raw AI prose is never
# member-facing. Keep Risk copy disabled until separately approved.
DAILY_EDGE_RENDERED_MARKET_READ_ENABLED=false
DAILY_EDGE_RENDERED_SUPPORTING_EVIDENCE_ENABLED=false
DAILY_EDGE_RENDERED_QUICK_READ_ENABLED=false
DAILY_EDGE_RENDERED_RISK_COPY_ENABLED=false

# MLB same-day grade corrections — default-on unless explicitly set false.
# These corrections only adjust member-facing Play Grade/actionability labels.
# They never change picks, model probabilities, projected scores, tracking rows,
# locked snapshots, odds, lines, splits, or raw model outputs.
MLB_FI_TOSSUP_FORCE_NO_PLAY_ENABLED=true
MLB_FI_MISSING_PRICE_BLOCKS_GRADE_STRENGTHENING_ENABLED=true
MLB_TOTALS_THIN_GAP_LEAN_CAP_ENABLED=true
MLB_ML_BEST_ANGLE_MOVEMENT_EDGE_CAP_ENABLED=true
MLB_ML_BEST_ANGLE_MOVEMENT_EDGE_CAP_WATCHLIST_ENABLED=false
MLB_ML_BEST_ANGLE_MOVEMENT_EDGE_CAP_ADAPTIVE_ENABLED=false
MLB_FI_NEGATIVE_THIN_EDGE_CAP_ENABLED=false
MLB_TOTALS_CALIBRATED_PROJECTION_INTERNAL_ENABLED=false
MLB_ML_CALIBRATED_PROBABILITY_INTERNAL_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Beta access password — pre-launch V1 access gate (Fix 5.1)
# ─────────────────────────────────────────────────────────────
# Gates /lab/* + /admin/* page routes and /api/lab/* API routes via the
# proxy.ts in the repo root. Members enter this password at /login;
# the route handler sets the `oddsphere_beta_session` cookie on success.
#
# Generate a strong random value with:  openssl rand -hex 24
# Distribute to beta members via Whop member announcement.
#
# If unset OR empty in production, the gate fails CLOSED — every Lab
# route redirects to /login and the login route refuses to validate any
# password. (Production safety: a missing env var cannot accidentally
# bypass the gate.)
#
# Phase 7 replaces this with Whop OAuth session validation.
LAB_BETA_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Data mode — controls whether member-facing routes surface mock data
# ─────────────────────────────────────────────────────────────
# Framework reference: planning-docs/SHARP_SIGNAL_FRAMEWORK.md
# §"Signal Source Quality" — "mock data NEVER ships to production member
# surfaces. Production builds filter source_type='mock' rows from all
# daily edge / pick breakdown / Tonight's Board / Top Reads outputs."
#
# Fix 5.1 Flag C1 (fail-closed inversion):
#   development → mock rows PASS THROUGH (use for local dev + QA seed data)
#   anything else (or unset) → mock rows FILTERED (production fail-closed)
#
# A typo, capitalization mistake, or missing env var leaves the filter
# active in production. Local dev must explicitly set `development`.
ODDSPHERE_DATA_MODE=development

# ─────────────────────────────────────────────────────────────
# Whop OAuth + access integration (Phase 6B.3a)
#
# Set WHOP_OAUTH_ENABLED=true ONLY when every other Whop env below is
# also set. Any missing var → lib/auth/whopConfig returns null → the
# login page hides the Whop button and the middleware does not trust
# any Whop session cookie. Fail-closed posture.
#
# Required when WHOP_OAUTH_ENABLED=true:
#   WHOP_CLIENT_ID          — "app_xxx" from your Whop developer app
#   WHOP_CLIENT_SECRET      — issued alongside the OAuth app; SERVER ONLY
#   WHOP_REDIRECT_URI       — EXACT match to a URI registered in your
#                             OAuth app config. Production typical value:
#                             https://oddsphereai.com/api/auth/whop/callback
#   WHOP_API_KEY            — server API key with permission to call the
#                             access-check endpoint
#   WHOP_RESOURCE_ID        — the Whop resource members must hold access
#                             to: prod_xxx (product), biz_xxx (company),
#                             or exp_xxx (experience). Check whichever
#                             matches your Whop store's structure.
#   WHOP_SESSION_SECRET     — local HMAC secret used to sign the cookie
#                             we issue after a successful access check.
#                             Generate with: openssl rand -hex 32
#                             Min 32 chars enforced in whopConfig.
#
# Optional / informational:
#   WHOP_CHECKOUT_URL       — public Whop checkout / store URL. Used as
#                             the "Get Access" link on /login + /pricing.
#                             Hidden when blank.
#
# Endpoints used (server-side only, hard-coded in lib/auth/whopOAuth +
# whopAccess so envs only carry secrets):
#   Authorize    https://api.whop.com/oauth/authorize
#   Token        https://api.whop.com/oauth/token
#   Userinfo     https://api.whop.com/oauth/userinfo
#   Access check https://api.whop.com/api/v1/users/{userId}/access/{resourceId}
#
# Beta password fallback (LAB_BETA_PASSWORD above) stays available as
# admin/emergency-override. Members with a beta cookie still pass the
# middleware gate even when Whop is enabled.
WHOP_OAUTH_ENABLED=false
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_REDIRECT_URI=
WHOP_API_KEY=
WHOP_RESOURCE_ID=
WHOP_SESSION_SECRET=
WHOP_CHECKOUT_URL=

# Private product relaunch candidates. Keep every switch false until the
# founder-approved cutover; preview routes remain protected separately.
PRODUCT_EXPERIENCE_PREVIEW_ENABLED=false
DAILY_EDGE_EXPERIENCE_CANDIDATE_ENABLED=false
PLAYER_PROPS_EXPERIENCE_CANDIDATE_ENABLED=false
TRACKING_EXPERIENCE_CANDIDATE_ENABLED=false
HOMEPAGE_EXPERIENCE_CANDIDATE_ENABLED=false
LOGIN_EXPERIENCE_CANDIDATE_ENABLED=false

# College Football Daily Edge. The evidence writer and member reader are
# independent rollback gates; the provider keys above remain server-only.
CFB_FORWARD_EVIDENCE_ENABLED=false
CFB_DAILY_EDGE_ENABLED=false
CFB_FORWARD_SEASON=2026

# MLB Player Props Engine
ODDSPHERE_WEATHER_API_KEY=
ODDSPHERE_MLB_PROVIDER=mock
ODDSPHERE_PROPS_MARKET_PROVIDER=sharpapi
ODDSPHERE_PROPS_STATS_PROVIDER=balldontlie
ODDSPHERE_PROPS_CONTEXT_PROVIDER=playbook
ODDSPHERE_PROP_MODEL_ENV=development
ODDSPHERE_PROP_BANKROLL_DEFAULT=1000
ODDSPHERE_PROP_MIN_EV=0.05
ODDSPHERE_PROP_MIN_EDGE=0.035
ODDSPHERE_PROP_MAX_ODDS_AGE_SECONDS=60
ODDSPHERE_PROPS_REAL_PUBLISH_ENABLED=false
ODDSPHERE_PROPS_DISPLAY_ENABLED=false
ODDSPHERE_PROPS_PUBLIC_API_ENABLED=false
ODDSPHERE_PROPS_PAPER_TRADING_ENABLED=false
ODDSPHERE_PROPS_REAL_CONTRACT_OVERRIDE=false
MLB_PLAYER_PROPS_CRON_ENABLED=false
# Private service-role-only ledger. This remains enabled before and after the
# member display flags are opened.
ODDSPHERE_PROPS_INTERNAL_TRACKING_ENABLED=false
MLB_PLAYER_PROPS_SETTLEMENT_CRON_ENABLED=false
ODDSPHERE_PROPS_MAX_PENDING_SETTLEMENTS=500
ODDSPHERE_PROPS_LAUNCH_CONSECUTIVE_SNAPSHOTS=3
ODDSPHERE_PROPS_LAUNCH_MIN_SEQUENCE_SPAN_MINUTES=15
ODDSPHERE_PROPS_MODEL_VERSION=mlb_props_distribution_v1
ODDSPHERE_PROPS_MAX_ODDS_AGE_MINUTES=45
ODDSPHERE_PROPS_MAX_SNAPSHOT_AGE_MINUTES=25
# Valid extreme prices stay visible for research, but prices outside this
# interval cannot become Radar items or positive model signals.
ODDSPHERE_PROPS_SIGNAL_MIN_AMERICAN_ODDS=-500
ODDSPHERE_PROPS_SIGNAL_MAX_AMERICAN_ODDS=1000
ODDSPHERE_PROPS_DISPLAY_ODDS_ABSOLUTE_LIMIT=10000
# Full-slate circuit breakers preserve the last known-good board instead of
# publishing an unexpectedly large provider response or member payload.
ODDSPHERE_PROPS_MAX_SOURCE_ODDS_ROWS=35000
ODDSPHERE_PROPS_MAX_BOARD_ROWS=7500
ODDSPHERE_PROPS_MAX_SNAPSHOT_JSON_BYTES=16000000
ODDSPHERE_PROPS_MAX_SNAPSHOT_GZIP_BYTES=1250000
ODDSPHERE_PROPS_MAX_BDL_CALLS_PER_REFRESH=300
# Direct career batter-vs-pitcher history is optional research. Full refreshes
# only fetch missing pairs and bound provider traffic; fast refreshes reuse it.
ODDSPHERE_PROPS_MAX_NEW_MATCHUP_HISTORY_CALLS=60
ODDSPHERE_PROPS_MATCHUP_HISTORY_CONCURRENCY=4
ODDSPHERE_PROPS_MATCHUP_HISTORY_TIMEOUT_MS=7000
ODDSPHERE_PROPS_MEMBER_READ_TIMEOUT_MS=2000
ODDSPHERE_PROPS_GAME_LOG_CONCURRENCY=8
ODDSPHERE_PROPS_PITCHER_STATS_CONCURRENCY=6

# Optional provider base URLs for non-default/staging integrations.
ODDSPHERE_SHARPAPI_BASE_URL=
ODDSPHERE_BALLDONTLIE_BASE_URL=
ODDSPHERE_PLAYBOOK_BASE_URL=
ODDSPHERE_MLB_STATS_API_BASE_URL=
ODDSPHERE_WEATHER_API_BASE_URL=
